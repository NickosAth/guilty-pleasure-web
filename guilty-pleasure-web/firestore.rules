rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@guiltypleasure.gr';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /usernames/{usernameId} {
      // Minimal login lookup. Do not add profile, role, or appointment data here.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /users/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /appointmentSlots/{slotId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && getAfter(/databases/$(database)/documents/appointments/$(slotId)).data.ownerUid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/appointments/$(slotId)).data.ownerUid == request.auth.uid);
    }
  }
}
